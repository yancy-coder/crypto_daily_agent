TZ=Asia/Shanghai
DAILY_PUSH_TIME=08:00
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_or_app_password
EMAIL_FROM=your_email@example.com
